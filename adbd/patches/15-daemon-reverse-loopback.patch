 #include "daemon/logging.h"
 #include "daemon/shell_service.h"
 
+// adb-anywhere: the device side of `adb reverse` listens on loopback only.
+// Upstream binds tcp:<port> on every interface, which would expose the
+// developer machine's port to the phone's Wi-Fi, cellular and VPN networks and
+// bypass the app's relay. Only tcp:<port>, tcp:localhost:<port> and
+// tcp:127.0.0.1:<port> are accepted, and socket_spec_listen binds them to
+// 127.0.0.1; every other host and every other socket type is refused.
+static bool reverse_listen_spec_allowed(std::string_view command, std::string* error) {
+    if (!android::base::ConsumePrefix(&command, "forward:")) {
+        return true;  // list-forward, killforward:, killforward-all
+    }
+    android::base::ConsumePrefix(&command, "norebind:");
+    size_t split = command.find(';');
+    // A std::string: parse_tcp_socket_spec reads the port through a C string.
+    std::string spec(command.substr(0, split));
+    std::string host;
+    int port = 0;
+    if (!spec.starts_with("tcp:") ||
+        !parse_tcp_socket_spec(spec, &host, &port, nullptr, error)) {
+        *error = "reverse listeners must be tcp:<port> on loopback";
+        return false;
+    }
+    if (!host.empty() && host != "localhost" && host != "127.0.0.1") {
+        *error = "reverse listeners bind loopback only";
+        return false;
+    }
+    return true;
+}
