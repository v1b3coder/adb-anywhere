+// adb-anywhere: PKCS#8 PEM of the tunnel's server key, as TlsConnection wants it.
+// Upstream uses adb::crypto::Key::ToPEMString, which drags in protobuf.
+static std::string PrivateKeyToPEM(EVP_PKEY* pkey) {
+    bssl::UniquePtr<BIO> bio(BIO_new(BIO_s_mem()));
+    if (PEM_write_bio_PKCS8PrivateKey(bio.get(), pkey, nullptr, nullptr, 0, nullptr, nullptr) !=
+        1) {
+        return "";
+    }
+    BUF_MEM* mem = nullptr;
+    BIO_get_mem_ptr(bio.get(), &mem);
+    if (!mem || !mem->data || !mem->length) return "";
+    return std::string(mem->data, mem->length);
+}
