+// adb-anywhere: the keys allowed to complete the TLS handshake. The file is
+// re-read on every handshake; a missing or empty file admits nobody.
+static void IterateTlsClientKeys(std::function<bool(std::string_view public_key)> f) {
+    std::string content;
+    if (tls_clients_path.empty() ||
+        !android::base::ReadFileToString(tls_clients_path, &content)) {
+        return;
     }
+    for (const std::string& raw : android::base::Split(content, "\n")) {
+        std::string line = android::base::Trim(raw);
+        if (line.empty() || line[0] == '#') continue;
+        if (!f(line)) break;
+    }
+}
 
+bool adbd_tls_configure(const std::string& key_path, const std::string& clients_path,
+                        std::string* error) {
+    std::string pem;
+    if (!android::base::ReadFileToString(key_path, &pem)) {
+        *error = "cannot read TLS key " + key_path + ": " + strerror(errno);
+        return false;
+    }
+    // PEM_read_bio_PrivateKey accepts both PKCS#8 and traditional RSA keys.
+    bssl::UniquePtr<BIO> bio(BIO_new_mem_buf(pem.data(), pem.size()));
+    bssl::UniquePtr<EVP_PKEY> pkey(PEM_read_bio_PrivateKey(bio.get(), nullptr, nullptr, nullptr));
+    if (!pkey) {
+        *error = "TLS key " + key_path + " is not a PEM private key";
+        return false;
+    }
+    RSA* rsa = EVP_PKEY_get1_RSA(pkey.get());
+    if (rsa == nullptr || RSA_bits(rsa) != 2048) {
+        if (rsa != nullptr) RSA_free(rsa);
+        *error = "TLS key " + key_path + " is not an RSA-2048 key";
+        return false;
+    }
+    tls_server_key = rsa;
+    tls_clients_path = clients_path;
+    return true;
+}
