+        size_t colon = rest.rfind(':');
+        if (colon == std::string::npos) {
+            *error = "missing host or port";
+            return false;
+        }
+        host = rest.substr(0, colon);
+        port_text = rest.substr(colon + 1);
+        if (host.find(':') != std::string::npos) {
+            *error = "IPv6 literals must be in brackets";
+            return false;
+        }
+    }
+    int port = 0;
+    if (host.empty() || port_text.empty() ||
+        port_text.find_first_not_of("0123456789") != std::string::npos ||
+        !android::base::ParseInt(port_text, &port, 1, 65535)) {
+        *error = "missing host or bad port";
+        return false;
+    }
+    addrinfo hints = {};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+    hints.ai_flags = AI_NUMERICHOST | AI_NUMERICSERV;
+    addrinfo* result = nullptr;
+    if (getaddrinfo(host.c_str(), port_text.c_str(), &hints, &result) != 0 || result == nullptr) {
+        *error = "the host is not a numeric address";
+        return false;
+    }
+    bool wildcard = false;
+    for (addrinfo* ai = result; ai != nullptr; ai = ai->ai_next) {
+        if (ai->ai_family == AF_INET) {
+            auto* in = reinterpret_cast<sockaddr_in*>(ai->ai_addr);
+            wildcard |= in->sin_addr.s_addr == htonl(INADDR_ANY);
+        } else if (ai->ai_family == AF_INET6) {
+            auto* in6 = reinterpret_cast<sockaddr_in6*>(ai->ai_addr);
+            static const uint8_t zero[4] = {};
+            wildcard |= IN6_IS_ADDR_UNSPECIFIED(&in6->sin6_addr) ||
+                        (IN6_IS_ADDR_V4MAPPED(&in6->sin6_addr) &&
+                         memcmp(&in6->sin6_addr.s6_addr[12], zero, sizeof(zero)) == 0);
+        }
+    }
+    freeaddrinfo(result);
+    if (wildcard) {
+        *error = "wildcard addresses are refused";
+        return false;
+    }
+    return true;
