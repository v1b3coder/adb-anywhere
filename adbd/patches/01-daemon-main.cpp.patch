+// The daemon's own files are private to the shell uid, and never followed
+// through a symlink.
+static int open_private(const std::string& path, int flags) {
+    int fd = unix_open(path, flags | O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd >= 0) fchmod(fd, 0600);
+    return fd;
