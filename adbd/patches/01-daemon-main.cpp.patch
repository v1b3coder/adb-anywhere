+// A listener spec is exactly tcp:<numeric address>:<port>. The address must be a
+// literal (IPv6 in brackets) that names one interface; the port is explicit.
+// There is no default port, no hostname lookup and no wildcard.
+static bool valid_listen_spec(const std::string& spec, std::string* error) {
+    if (!spec.starts_with("tcp:")) {
+        *error = "not a tcp: spec";
+        return false;
+    }
+    std::string rest = spec.substr(4);
+    std::string host;
+    std::string port_text;
+    if (!rest.empty() && rest[0] == '[') {
+        size_t close = rest.find(']');
+        if (close == std::string::npos || close + 1 >= rest.size() || rest[close + 1] != ':') {
+            *error = "bad IPv6 literal";
+            return false;
         }
+        host = rest.substr(1, close - 1);
+        port_text = rest.substr(close + 2);
     } else {
-        // minijail_enter() will abort if any priv-dropping step fails.
