+// The daemon is started from a shell of the system adbd, which can leak a
+// descriptor of its own (the shell service socket) into the child. Holding it
+// keeps the starting `adb shell` from ever seeing EOF and lets this daemon keep
+// a system adbd socket. Close everything but stdio before anything is opened.
+static void close_inherited_fds() {
+    DIR* dir = opendir("/proc/self/fd");
+    if (dir == nullptr) return;
+    std::vector<int> fds;
+    while (dirent* entry = readdir(dir)) {
+        int fd;
+        if (android::base::ParseInt(entry->d_name, &fd) && fd > STDERR_FILENO &&
+            fd != dirfd(dir)) {
+            fds.push_back(fd);
         }
     }
+    closedir(dir);
+    for (int fd : fds) unix_close(fd);
 }
