+static void redirect_log(const std::string& path) {
+    if (path.empty()) return;
+    // Rotate at startup: the app trims the files while the daemon is
+    // stopped, and this bounds a predecessor's log that was not trimmed.
+    struct stat st;
+    if (lstat(path.c_str(), &st) == 0 && S_ISREG(st.st_mode) && st.st_size > (1 << 20)) {
+        rename(path.c_str(), (path + ".1").c_str());
+    }
+    int fd = open_private(path, O_APPEND);
+    if (fd < 0) {
+        PLOG(ERROR) << "cannot open log " << path;
+        return;
+    }
+    dup2(fd, STDERR_FILENO);
+    unix_close(fd);
 }
 
