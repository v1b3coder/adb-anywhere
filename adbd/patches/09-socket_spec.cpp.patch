+// AOSP's socket_spec_listen only binds loopback or every interface. The
+// standalone daemon is given an explicit VPN address by the app, so bind the
+// address it names. A wildcard is refused: the app never asks for one.
+static int listen_on_host(std::string_view hostname, int port, int type, std::string* error) {
+    if (hostname.empty() || hostname == "0.0.0.0" || hostname == "::" || hostname == "*") {
+        *error = "wildcard binds are refused";
+        return -1;
+    }
+    addrinfo hints = {};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = type;
+    hints.ai_flags = AI_NUMERICHOST | AI_PASSIVE;
+
+    addrinfo* result = nullptr;
+    std::string host(hostname);
+    std::string port_str = std::to_string(port);
+    int rc = getaddrinfo(host.c_str(), port_str.c_str(), &hints, &result);
+    if (rc != 0) {
+        *error = gai_strerror(rc);
+        return -1;
+    }
+
+    unique_fd fd;
+    for (addrinfo* ai = result; ai != nullptr; ai = ai->ai_next) {
+        fd.reset(socket(ai->ai_family, ai->ai_socktype | SOCK_CLOEXEC, ai->ai_protocol));
+        if (fd == -1) {
+            continue;
+        }
+        int n = 1;
+        adb_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &n, sizeof(n));
+        if (bind(fd.get(), ai->ai_addr, ai->ai_addrlen) == 0 &&
+            (type != SOCK_STREAM || listen(fd.get(), SOMAXCONN) == 0)) {
+            break;
+        }
+        fd.reset();
+    }
+    freeaddrinfo(result);
+
+    if (fd == -1) {
+        *error = strerror(errno);
+        return -1;
+    }
+    return fd.release();
+}
