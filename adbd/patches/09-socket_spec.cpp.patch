+// True for 0.0.0.0, :: and ::ffff:0.0.0.0: an address that binds every interface.
+static bool is_wildcard_address(const sockaddr* addr) {
+    if (addr->sa_family == AF_INET) {
+        return reinterpret_cast<const sockaddr_in*>(addr)->sin_addr.s_addr == htonl(INADDR_ANY);
+    }
+    if (addr->sa_family == AF_INET6) {
+        const in6_addr& a = reinterpret_cast<const sockaddr_in6*>(addr)->sin6_addr;
+        if (IN6_IS_ADDR_UNSPECIFIED(&a)) return true;
+        if (IN6_IS_ADDR_V4MAPPED(&a)) {
+            static const uint8_t zero[4] = {};
+            return memcmp(&a.s6_addr[12], zero, sizeof(zero)) == 0;
+        }
+    }
+    return false;
+}
+
+// AOSP's socket_spec_listen only binds loopback or every interface. The
+// standalone daemon is given an explicit VPN address by the app, so bind the
+// address it names. A wildcard is refused after the address is parsed, so no
+// spelling of it (0, 0.0, ::0, [::], ::ffff:0.0.0.0) gets through.
+static int listen_on_host(std::string_view hostname, int port, int type, std::string* error) {
+    if (hostname.empty()) {
+        *error = "wildcard binds are refused";
+        return -1;
+    }
+    addrinfo hints = {};
+    hints.ai_family = AF_UNSPEC;
+    hints.ai_socktype = type;
+    hints.ai_flags = AI_NUMERICHOST | AI_PASSIVE;
+
+    addrinfo* result = nullptr;
+    std::string host(hostname);
+    std::string port_str = std::to_string(port);
+    int rc = getaddrinfo(host.c_str(), port_str.c_str(), &hints, &result);
+    if (rc != 0) {
+        *error = gai_strerror(rc);
+        return -1;
+    }
+
+    for (addrinfo* ai = result; ai != nullptr; ai = ai->ai_next) {
+        if (is_wildcard_address(ai->ai_addr)) {
+            freeaddrinfo(result);
+            *error = "wildcard binds are refused";
+            errno = EINVAL;
+            return -1;
+        }
+    }
+
+    unique_fd fd;
+    for (addrinfo* ai = result; ai != nullptr; ai = ai->ai_next) {
+        fd.reset(socket(ai->ai_family, ai->ai_socktype | SOCK_CLOEXEC, ai->ai_protocol));
+        if (fd == -1) {
+            continue;
+        }
+        int n = 1;
+        adb_setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &n, sizeof(n));
+        if (bind(fd.get(), ai->ai_addr, ai->ai_addrlen) == 0 &&
+            (type != SOCK_STREAM || listen(fd.get(), SOMAXCONN) == 0)) {
+            break;
+        }
+        fd.reset();
+    }
+    freeaddrinfo(result);
+
+    if (fd == -1) {
+        *error = strerror(errno);
+        return -1;
+    }
+    return fd.release();
+}
